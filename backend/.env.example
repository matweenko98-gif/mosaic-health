# --- Общие ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- База данных (PostgreSQL) ---
# Локально: одинаковые. Supabase: DATABASE_URL — пул (порт 6543, ?pgbouncer=true),
# DIRECT_URL — прямое подключение (порт 5432, для миграций).
DATABASE_URL="postgresql://USER@localhost:5432/mosaic_health?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/mosaic_health?schema=public"

# --- JWT (токены входа) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Хранилище файлов (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MEDIA=media
S3_BUCKET_AVATARS=avatars
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL=3600

# --- Онлайн-оплата ---
# Пока PAYMENTS_ENABLED != true — оплата выключена, заказ оформляется по старой схеме.
PAYMENTS_ENABLED=false
# Провайдер: stripe (Дубай/Черногория, по умолчанию) или yookassa (Россия).
PAYMENTS_PROVIDER=stripe
# Валюта магазина: AED (Дубай), EUR (Черногория), RUB (Россия).
STORE_CURRENCY=AED

# Stripe (юрлицо ОАЭ) — основной провайдер для Дубая/Черногории.
STRIPE_SECRET_KEY=

# ЮKassa (Россия) — для запуска РФ позже.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Фискальные чеки (54-ФЗ): включать, когда касса настроена в кабинете ЮKassa.
YOOKASSA_SEND_RECEIPT=false
# Код ставки НДС: 1 — без НДС, 2 — 0%, 6 — 20% и т.д. (см. документацию ЮKassa).
YOOKASSA_VAT_CODE=1

# --- Push-уведомления (web-push / PWA) ---
# Ключи генерируются командой: npx web-push generate-vapid-keys
# Пока ключи пустые — push выключен, работает только «колокольчик» в приложении.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mosaic.health
